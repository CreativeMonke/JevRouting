{
  "name": "jev-routing",
  "version": "0.1.0",
  "description": "Cache-aware multi-model task router: Jev System One classifier -> configurable providers (LiteLLM, Claude Code, OpenCode, Antigravity)",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "JEV_LIVE=1 vitest run test/live",
    "jev": "tsx src/cli.ts",
    "catalog:refresh": "tsx scripts/refresh-catalog-snapshot.ts",
    "bench": "tsx bench/run.ts --config examples/cli.config.yaml",
    "bench:report": "tsx bench/report.ts",
    "clef:serve": "scripts/clef-serve.sh"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "jev": "./bin/jev.mjs"
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
